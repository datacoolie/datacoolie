# Copy to .env.integration.local. Never put credentials or tokens in this file.
# The commented assignments below show the expected value format. Uncomment or
# copy only the coordinates for the cloud resource you intend to test.

# Fabric / OneLake resource coordinates. The qualified OneLake URI is derived
# from the workspace and Lakehouse GUIDs unless the explicit URI is supplied.
# DATACOOLIE_FABRIC_TENANT_ID=00000000-0000-0000-0000-000000000000
DATACOOLIE_FABRIC_TENANT_ID=
# DATACOOLIE_FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
DATACOOLIE_FABRIC_WORKSPACE_ID=
# DATACOOLIE_FABRIC_LAKEHOUSE_ID=00000000-0000-0000-0000-000000000002
DATACOOLIE_FABRIC_LAKEHOUSE_ID=
# DATACOOLIE_FABRIC_ONELAKE_TEST_URI=abfss://workspace-guid@onelake.dfs.fabric.microsoft.com/lakehouse-guid/Files
DATACOOLIE_FABRIC_ONELAKE_TEST_URI=
# DATACOOLIE_FABRIC_LIST_BENCHMARK_ROOT=Files
DATACOOLIE_FABRIC_LIST_BENCHMARK_ROOT=
# DATACOOLIE_FABRIC_KEYVAULT_TEST_URL=https://my-vault.vault.azure.net/
DATACOOLIE_FABRIC_KEYVAULT_TEST_URL=
# DATACOOLIE_FABRIC_KEYVAULT_TEST_SECRET_NAME=datacoolie-test-secret
DATACOOLIE_FABRIC_KEYVAULT_TEST_SECRET_NAME=

# AWS resource coordinates. Authentication stays in the boto3 credential chain.
# DATACOOLIE_AWS_REGION=ap-southeast-1
DATACOOLIE_AWS_REGION=
# DATACOOLIE_AWS_BUCKET=my-datacoolie-integration-bucket
DATACOOLIE_AWS_BUCKET=
# Leave empty for AWS S3. For the local use-case-sim MinIO service, use:
# DATACOOLIE_AWS_ENDPOINT_URL=http://localhost:9000
DATACOOLIE_AWS_ENDPOINT_URL=
# DATACOOLIE_AWS_TEST_PREFIX=datacoolie-integration
DATACOOLIE_AWS_TEST_PREFIX=
# Relative to the configured bucket/prefix; for example: metadata
# DATACOOLIE_AWS_LIST_BENCHMARK_ROOT=metadata
DATACOOLIE_AWS_LIST_BENCHMARK_ROOT=

# Databricks resource coordinates. Authentication stays in the Databricks
# CLI/profile, workload identity, or CI secret environment.
# DATACOOLIE_DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATACOOLIE_DATABRICKS_HOST=
# DATACOOLIE_DATABRICKS_CATALOG=workspace
DATACOOLIE_DATABRICKS_CATALOG=
# DATACOOLIE_DATABRICKS_SCHEMA=default
DATACOOLIE_DATABRICKS_SCHEMA=
# DATACOOLIE_DATABRICKS_VOLUME=test
DATACOOLIE_DATABRICKS_VOLUME=
# DATACOOLIE_DATABRICKS_TEST_PREFIX=datacoolie-integration
DATACOOLIE_DATABRICKS_TEST_PREFIX=
# Relative to /Volumes/<catalog>/<schema>/<volume>; for example: metadata
# DATACOOLIE_DATABRICKS_LIST_BENCHMARK_ROOT=metadata
DATACOOLIE_DATABRICKS_LIST_BENCHMARK_ROOT=
# DATACOOLIE_DATABRICKS_SECRET_SCOPE=datacoolie-test-scope
DATACOOLIE_DATABRICKS_SECRET_SCOPE=
# DATACOOLIE_DATABRICKS_SECRET_KEY=datacoolie-test-key
DATACOOLIE_DATABRICKS_SECRET_KEY=
# DATACOOLIE_DATABRICKS_CLUSTER_ID=0123-456789-abcd123
DATACOOLIE_DATABRICKS_CLUSTER_ID=
