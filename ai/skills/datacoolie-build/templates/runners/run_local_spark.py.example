"""DataCoolie local Spark runner reference."""

from __future__ import annotations

import argparse
import logging

from pyspark.sql import SparkSession

from datacoolie.core.models import DataCoolieRunConfig
from datacoolie.engines.spark_engine import SparkEngine
from datacoolie.metadata.file_provider import FileProvider
from datacoolie.orchestration.driver import DataCoolieDriver
from datacoolie.platforms.local_platform import LocalPlatform


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--metadata-path", required=True)
    parser.add_argument("--watermark-base-path", required=True)
    parser.add_argument("--base-log-path", required=True)
    parser.add_argument("--stage")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--max-workers", type=int, default=4)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    platform = LocalPlatform()
    spark = SparkSession.builder.appName("{project_name}").getOrCreate()
    try:
        engine = SparkEngine(spark_session=spark, platform=platform)
        metadata = FileProvider(
            config_path=args.metadata_path,
            platform=platform,
            watermark_base_path=args.watermark_base_path,
        )
        config = DataCoolieRunConfig(
            dry_run=args.dry_run, max_workers=args.max_workers, stop_on_error=True
        )

        failed = 0
        with DataCoolieDriver(
            engine=engine,
            metadata_provider=metadata,
            base_log_path=args.base_log_path,
            config=config,
        ) as driver:
            result = driver.run(stage=args.stage)
            failed = result.failed

        return 1 if failed else 0
    finally:
        spark.stop()


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    raise SystemExit(main())
