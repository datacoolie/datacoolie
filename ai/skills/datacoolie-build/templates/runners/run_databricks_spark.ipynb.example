{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# DataCoolie Databricks Spark Runner\n",
    "\n",
    "Attach the verified DataCoolie and functions artifacts to the job before execution. Stage groups execute in outer-list order."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {"tags": ["parameters"]},
   "outputs": [],
   "source": [
    "METADATA_PATH = \"{metadata_path}\"\n",
    "WATERMARK_BASE_PATH = \"{watermark_base_path}\"\n",
    "BASE_LOG_PATH = \"{base_log_path}\"\n",
    "STAGE_GROUPS_JSON = \"[]\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from importlib.metadata import PackageNotFoundError, version\n",
    "from pathlib import PurePosixPath\n",
    "from urllib.parse import urlparse\n",
    "\n",
    "def widget_value(name, default):\n",
    "    try:\n",
    "        return dbutils.widgets.get(name)  # type: ignore[name-defined]\n",
    "    except Exception:\n",
    "        dbutils.widgets.text(name, str(default))  # type: ignore[name-defined]\n",
    "        return dbutils.widgets.get(name)  # type: ignore[name-defined]\n",
    "\n",
    "def parse_stage_plan(value):\n",
    "    groups = json.loads(value)\n",
    "    if not isinstance(groups, list):\n",
    "        raise ValueError(\"STAGE_GROUPS_JSON must decode to a list\")\n",
    "    for group in groups:\n",
    "        valid_string = isinstance(group, str) and bool(group.strip())\n",
    "        valid_list = isinstance(group, list) and bool(group) and all(isinstance(stage, str) and stage.strip() for stage in group)\n",
    "        if not (valid_string or valid_list):\n",
    "            raise ValueError(\"invalid stage group\")\n",
    "    return groups\n",
    "\n",
    "def require_persistent_path(value):\n",
    "    parts = PurePosixPath(urlparse(value).path.replace(\"\\\\\", \"/\")).parts\n",
    "    if \".builds\" in {part.lower() for part in parts}:\n",
    "        raise ValueError(\"mutable state path must be outside .builds/\")\n",
    "    return value\n",
    "\n",
    "try:\n",
    "    print(f\"DataCoolie version: {version('datacoolie')}\")\n",
    "except PackageNotFoundError as exc:\n",
    "    raise RuntimeError(\"Attach the verified DataCoolie package before running this notebook\") from exc\n",
    "\n",
    "metadata_path = widget_value(\"METADATA_PATH\", METADATA_PATH)\n",
    "watermark_base_path = widget_value(\"WATERMARK_BASE_PATH\", WATERMARK_BASE_PATH)\n",
    "base_log_path = widget_value(\"BASE_LOG_PATH\", BASE_LOG_PATH)\n",
    "stage_plan = parse_stage_plan(widget_value(\"STAGE_GROUPS_JSON\", STAGE_GROUPS_JSON))\n",
    "\n",
    "from datacoolie.core.models import DataCoolieRunConfig\n",
    "from datacoolie.engines.spark_engine import SparkEngine\n",
    "from datacoolie.metadata.file_provider import FileProvider\n",
    "from datacoolie.orchestration.driver import DataCoolieDriver\n",
    "from datacoolie.platforms.databricks_platform import DatabricksPlatform\n",
    "\n",
    "platform = DatabricksPlatform()\n",
    "engine = SparkEngine(spark_session=spark, platform=platform)  # type: ignore[name-defined]\n",
    "metadata = FileProvider(config_path=metadata_path, platform=platform, watermark_base_path=require_persistent_path(watermark_base_path))\n",
    "config = DataCoolieRunConfig(max_workers=4, stop_on_error=True)\n",
    "\n",
    "failed = 0\n",
    "with DataCoolieDriver(engine=engine, metadata_provider=metadata, base_log_path=require_persistent_path(base_log_path), config=config) as driver:\n",
    "    for stage_group in stage_plan or [None]:\n",
    "        result = driver.run(stage=stage_group)\n",
    "        failed += result.failed\n",
    "        if result.failed:\n",
    "            break\n",
    "if failed:\n",
    "    raise RuntimeError(f\"DataCoolie run failed for {failed} dataflows\")"
   ]
  }
 ],
 "metadata": {"kernelspec": {"display_name": "Python 3", "language": "python", "name": "python3"}, "language_info": {"name": "python", "version": "3.11"}},
 "nbformat": 4,
 "nbformat_minor": 5
}
