{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["# DataCoolie Databricks Spark Replay\n", "Attach verified dependencies before execution. Range semantics are `[START, END)`." ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {"tags": ["parameters"]},
   "outputs": [],
   "source": [
    "METADATA_PATH = \"{metadata_path}\"\n",
    "WATERMARK_BASE_PATH = \"{watermark_base_path}\"\n",
    "BASE_LOG_PATH = \"{base_log_path}\"\n",
    "STAGE_GROUPS_JSON = \"[]\"\n",
    "START = \"2025-01-01\"\n",
    "END = \"2025-02-01\"\n",
    "CHUNK_INTERVAL_JSON = \"null\"\n",
    "CHUNK_COLUMN = \"\"\n",
    "SAVE_WATERMARK = \"false\"\n",
    "CONFIRM_SAVE_WATERMARK = \"false\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "import re\n",
    "from importlib.metadata import PackageNotFoundError, version\n",
    "from pathlib import PurePosixPath\n",
    "from urllib.parse import urlparse\n",
    "\n",
    "CHUNK_KEYS = {\"years\", \"months\", \"weeks\", \"days\", \"hours\", \"minutes\", \"step\"}\n",
    "\n",
    "def widget_value(name, default):\n",
    "    try:\n",
    "        return dbutils.widgets.get(name)  # type: ignore[name-defined]\n",
    "    except Exception:\n",
    "        dbutils.widgets.text(name, str(default))  # type: ignore[name-defined]\n",
    "        return dbutils.widgets.get(name)  # type: ignore[name-defined]\n",
    "\n",
    "def parse_bool(value):\n",
    "    normalized = value.strip().lower()\n",
    "    if normalized not in {\"true\", \"false\"}:\n",
    "        raise ValueError(\"boolean widget must be true or false\")\n",
    "    return normalized == \"true\"\n",
    "\n",
    "def parse_boundary(value):\n",
    "    return int(value) if re.fullmatch(r\"[+-]?\\d+\", value) else value\n",
    "\n",
    "def parse_stage_plan(value):\n",
    "    groups = json.loads(value)\n",
    "    if not isinstance(groups, list):\n",
    "        raise ValueError(\"STAGE_GROUPS_JSON must decode to a list\")\n",
    "    for group in groups:\n",
    "        valid_string = isinstance(group, str) and bool(group.strip())\n",
    "        valid_list = isinstance(group, list) and bool(group) and all(isinstance(stage, str) and stage.strip() for stage in group)\n",
    "        if not (valid_string or valid_list):\n",
    "            raise ValueError(\"invalid stage group\")\n",
    "    return groups\n",
    "\n",
    "def parse_chunk_interval(value):\n",
    "    interval = json.loads(value)\n",
    "    if interval is None:\n",
    "        return None\n",
    "    if not isinstance(interval, dict) or len(interval) != 1:\n",
    "        raise ValueError(\"CHUNK_INTERVAL_JSON must be null or a one-key object\")\n",
    "    key, amount = next(iter(interval.items()))\n",
    "    if key not in CHUNK_KEYS or isinstance(amount, bool) or not isinstance(amount, int) or amount <= 0:\n",
    "        raise ValueError(\"chunk interval requires one supported key with a positive integer\")\n",
    "    return interval\n",
    "\n",
    "def validate_watermark_request(save_watermark, confirm_save_watermark):\n",
    "    if save_watermark and not confirm_save_watermark:\n",
    "        raise ValueError(\"SAVE_WATERMARK requires CONFIRM_SAVE_WATERMARK\")\n",
    "\n",
    "def require_persistent_path(value):\n",
    "    parts = PurePosixPath(urlparse(value).path.replace(\"\\\\\", \"/\")).parts\n",
    "    if \".builds\" in {part.lower() for part in parts}:\n",
    "        raise ValueError(\"mutable state path must be outside .builds/\")\n",
    "    return value\n",
    "\n",
    "try:\n",
    "    print(f\"DataCoolie version: {version('datacoolie')}\")\n",
    "except PackageNotFoundError as exc:\n",
    "    raise RuntimeError(\"Attach the verified DataCoolie package before running this notebook\") from exc\n",
    "\n",
    "metadata_path = widget_value(\"METADATA_PATH\", METADATA_PATH)\n",
    "watermark_base_path = widget_value(\"WATERMARK_BASE_PATH\", WATERMARK_BASE_PATH)\n",
    "base_log_path = widget_value(\"BASE_LOG_PATH\", BASE_LOG_PATH)\n",
    "stage_plan = parse_stage_plan(widget_value(\"STAGE_GROUPS_JSON\", STAGE_GROUPS_JSON))\n",
    "start = parse_boundary(widget_value(\"START\", START))\n",
    "end = parse_boundary(widget_value(\"END\", END))\n",
    "chunk_interval = parse_chunk_interval(widget_value(\"CHUNK_INTERVAL_JSON\", CHUNK_INTERVAL_JSON))\n",
    "chunk_column = widget_value(\"CHUNK_COLUMN\", CHUNK_COLUMN).strip() or None\n",
    "save_watermark = parse_bool(widget_value(\"SAVE_WATERMARK\", SAVE_WATERMARK))\n",
    "confirm_save_watermark = parse_bool(widget_value(\"CONFIRM_SAVE_WATERMARK\", CONFIRM_SAVE_WATERMARK))\n",
    "validate_watermark_request(save_watermark, confirm_save_watermark)\n",
    "\n",
    "from datacoolie.core.models import DataCoolieRunConfig, ReplayConfig\n",
    "from datacoolie.engines.spark_engine import SparkEngine\n",
    "from datacoolie.metadata.file_provider import FileProvider\n",
    "from datacoolie.orchestration.driver import DataCoolieDriver\n",
    "from datacoolie.platforms.databricks_platform import DatabricksPlatform\n",
    "\n",
    "platform = DatabricksPlatform()\n",
    "engine = SparkEngine(spark_session=spark, platform=platform)  # type: ignore[name-defined]\n",
    "metadata = FileProvider(config_path=metadata_path, platform=platform, watermark_base_path=require_persistent_path(watermark_base_path))\n",
    "replay = ReplayConfig(start=start, end=end, chunk_interval=chunk_interval, save_watermark=save_watermark, chunk_column=chunk_column)\n",
    "\n",
    "failed = 0\n",
    "with DataCoolieDriver(engine=engine, metadata_provider=metadata, base_log_path=require_persistent_path(base_log_path), config=DataCoolieRunConfig(stop_on_error=True)) as driver:\n",
    "    for stage_group in stage_plan or [None]:\n",
    "        dataflows = driver.load_dataflows(stage=stage_group)\n",
    "        result = driver.run_replay(dataflows=dataflows, replay=replay)\n",
    "        failed += result.failed\n",
    "        if result.failed:\n",
    "            break\n",
    "if failed:\n",
    "    raise RuntimeError(f\"DataCoolie replay failed for {failed} dataflows\")"
   ]
  }
 ],
 "metadata": {"kernelspec": {"display_name": "Python 3", "language": "python", "name": "python3"}, "language_info": {"name": "python", "version": "3.11"}},
 "nbformat": 4,
 "nbformat_minor": 5
}
