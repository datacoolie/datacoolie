{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# DataCoolie Fabric Spark Runner\n",
    "\n",
    "Attach the verified DataCoolie and functions artifacts to the environment before execution. STAGE is passed unchanged to one framework call."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {"tags": ["parameters"]},
   "outputs": [],
   "source": [
    "METADATA_PATH = \"{metadata_path}\"\n",
    "WATERMARK_BASE_PATH = \"{watermark_base_path}\"\n",
    "BASE_LOG_PATH = \"{base_log_path}\"\n",
    "STAGE = \"\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from importlib.metadata import PackageNotFoundError, version\n",
    "try:\n",
    "    print(f\"DataCoolie version: {version('datacoolie')}\")\n",
    "except PackageNotFoundError as exc:\n",
    "    raise RuntimeError(\"Attach the verified DataCoolie package before running this notebook\") from exc\n",
    "\n",
    "from datacoolie.core.models import DataCoolieRunConfig\n",
    "from datacoolie.engines.spark_engine import SparkEngine\n",
    "from datacoolie.metadata.file_provider import FileProvider\n",
    "from datacoolie.orchestration.driver import DataCoolieDriver\n",
    "from datacoolie.platforms.fabric_platform import FabricPlatform\n",
    "\n",
    "platform = FabricPlatform()\n",
    "engine = SparkEngine(spark_session=spark, platform=platform)  # type: ignore[name-defined]\n",
    "metadata = FileProvider(config_path=METADATA_PATH, platform=platform, watermark_base_path=WATERMARK_BASE_PATH)\n",
    "config = DataCoolieRunConfig(max_workers=4, stop_on_error=True)\n",
    "\n",
    "failed = 0\n",
    "with DataCoolieDriver(engine=engine, metadata_provider=metadata, base_log_path=BASE_LOG_PATH, config=config) as driver:\n",
    "    result = driver.run(stage=STAGE)\n",
    "    failed = result.failed\n",
    "if failed:\n",
    "    raise RuntimeError(f\"DataCoolie run failed for {failed} dataflows\")"
   ]
  }
 ],
 "metadata": {"kernelspec": {"display_name": "Python 3", "language": "python", "name": "python3"}, "language_info": {"name": "python", "version": "3.11"}},
