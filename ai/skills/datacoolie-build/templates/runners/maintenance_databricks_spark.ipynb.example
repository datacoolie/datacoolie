{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["# DataCoolie Databricks Spark Maintenance\n", "Attach verified dependencies before execution. Inspect deduplicated physical targets before confirmed mutation." ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {"tags": ["parameters"]},
   "outputs": [],
   "source": [
    "METADATA_PATH = \"{metadata_path}\"\n",
    "WATERMARK_BASE_PATH = \"{watermark_base_path}\"\n",
    "BASE_LOG_PATH = \"{base_log_path}\"\n",
    "CONNECTIONS_JSON = \"[]\"\n",
    "DO_COMPACT = \"true\"\n",
    "DO_CLEANUP = \"true\"\n",
    "RETENTION_HOURS = \"168\"\n",
    "INSPECT_ONLY = \"true\"\n",
    "CONFIRM_MAINTENANCE = \"false\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from importlib.metadata import PackageNotFoundError, version\n",
    "from pathlib import PurePosixPath\n",
    "from urllib.parse import urlparse\n",
    "\n",
    "def widget_value(name, default):\n",
    "    try:\n",
    "        return dbutils.widgets.get(name)  # type: ignore[name-defined]\n",
    "    except Exception:\n",
    "        dbutils.widgets.text(name, str(default))  # type: ignore[name-defined]\n",
    "        return dbutils.widgets.get(name)  # type: ignore[name-defined]\n",
    "\n",
    "def parse_bool(value):\n",
    "    normalized = value.strip().lower()\n",
    "    if normalized not in {\"true\", \"false\"}:\n",
    "        raise ValueError(\"boolean widget must be true or false\")\n",
    "    return normalized == \"true\"\n",
    "\n",
    "def parse_positive_int(value, name):\n",
    "    try:\n",
    "        parsed = int(value)\n",
    "    except ValueError as exc:\n",
    "        raise ValueError(f\"{name} must be an integer\") from exc\n",
    "    if parsed <= 0:\n",
    "        raise ValueError(f\"{name} must be positive\")\n",
    "    return parsed\n",
    "\n",
    "def parse_connections(value):\n",
    "    connections = json.loads(value)\n",
    "    if not isinstance(connections, list) or not all(isinstance(item, str) and item.strip() for item in connections):\n",
    "        raise ValueError(\"CONNECTIONS_JSON must decode to a list of non-blank strings\")\n",
    "    return connections\n",
    "\n",
    "def validate_maintenance_request(do_compact, do_cleanup, inspect_only, confirm_maintenance):\n",
    "    if not do_compact and not do_cleanup:\n",
    "        raise ValueError(\"maintenance must enable compact, cleanup, or both\")\n",
    "    if not inspect_only and not confirm_maintenance:\n",
    "        raise ValueError(\"maintenance mutation requires CONFIRM_MAINTENANCE\")\n",
    "\n",
    "def require_persistent_path(value):\n",
    "    parts = PurePosixPath(urlparse(value).path.replace(\"\\\\\", \"/\")).parts\n",
    "    if \".builds\" in {part.lower() for part in parts}:\n",
    "        raise ValueError(\"mutable state path must be outside .builds/\")\n",
    "    return value\n",
    "\n",
    "def build_maintenance_preview(targets, *, do_compact, do_cleanup, retention_hours):\n",
    "    operations = [operation for operation, enabled in ((\"compact\", do_compact), (\"cleanup\", do_cleanup)) if enabled]\n",
    "    preview = []\n",
    "    for target in targets:\n",
    "        destination = target.destination\n",
    "        preview.append({\"dataflow\": target.name or target.dataflow_id, \"connection\": destination.connection.name, \"format\": destination.connection.format, \"destination_key\": destination.destination_key, \"table\": destination.full_table_name, \"path\": destination.path, \"operations\": operations, \"retention_hours\": retention_hours})\n",
    "    return sorted(preview, key=lambda item: item[\"destination_key\"])\n",
    "\n",
    "try:\n",
    "    print(f\"DataCoolie version: {version('datacoolie')}\")\n",
    "except PackageNotFoundError as exc:\n",
    "    raise RuntimeError(\"Attach the verified DataCoolie package before running this notebook\") from exc\n",
    "\n",
    "metadata_path = widget_value(\"METADATA_PATH\", METADATA_PATH)\n",
    "watermark_base_path = widget_value(\"WATERMARK_BASE_PATH\", WATERMARK_BASE_PATH)\n",
    "base_log_path = widget_value(\"BASE_LOG_PATH\", BASE_LOG_PATH)\n",
    "connections = parse_connections(widget_value(\"CONNECTIONS_JSON\", CONNECTIONS_JSON))\n",
    "do_compact = parse_bool(widget_value(\"DO_COMPACT\", DO_COMPACT))\n",
    "do_cleanup = parse_bool(widget_value(\"DO_CLEANUP\", DO_CLEANUP))\n",
    "retention_hours = parse_positive_int(widget_value(\"RETENTION_HOURS\", RETENTION_HOURS), \"RETENTION_HOURS\")\n",
    "inspect_only = parse_bool(widget_value(\"INSPECT_ONLY\", INSPECT_ONLY))\n",
    "confirm_maintenance = parse_bool(widget_value(\"CONFIRM_MAINTENANCE\", CONFIRM_MAINTENANCE))\n",
    "validate_maintenance_request(do_compact, do_cleanup, inspect_only, confirm_maintenance)\n",
    "\n",
    "from datacoolie.core.models import DataCoolieRunConfig\n",
    "from datacoolie.engines.spark_engine import SparkEngine\n",
    "from datacoolie.metadata.file_provider import FileProvider\n",
    "from datacoolie.orchestration.driver import DataCoolieDriver\n",
    "from datacoolie.platforms.databricks_platform import DatabricksPlatform\n",
    "\n",
    "platform = DatabricksPlatform()\n",
    "engine = SparkEngine(spark_session=spark, platform=platform)  # type: ignore[name-defined]\n",
    "metadata = FileProvider(config_path=metadata_path, platform=platform, watermark_base_path=require_persistent_path(watermark_base_path))\n",
    "config = DataCoolieRunConfig(retention_hours=retention_hours, stop_on_error=True)\n",
    "\n",
    "with DataCoolieDriver(engine=engine, metadata_provider=metadata, base_log_path=require_persistent_path(base_log_path), config=config) as driver:\n",
    "    if inspect_only:\n",
    "        targets = driver.load_maintenance_dataflows(connection=connections or None)\n",
    "        preview = build_maintenance_preview(targets, do_compact=do_compact, do_cleanup=do_cleanup, retention_hours=retention_hours)\n",
    "        print(json.dumps(preview, indent=2, sort_keys=True))\n",
    "    else:\n",
    "        print(json.dumps({\"connections\": connections, \"operations\": [operation for operation, enabled in ((\"compact\", do_compact), (\"cleanup\", do_cleanup)) if enabled], \"retention_hours\": retention_hours}, sort_keys=True))\n",
    "        result = driver.run_maintenance(connection=connections or None, do_compact=do_compact, do_cleanup=do_cleanup)\n",
    "        if result.failed:\n",
    "            raise RuntimeError(f\"DataCoolie maintenance failed for {result.failed} dataflows\")"
   ]
  }
 ],
 "metadata": {"kernelspec": {"display_name": "Python 3", "language": "python", "name": "python3"}, "language_info": {"name": "python", "version": "3.11"}},
 "nbformat": 4,
 "nbformat_minor": 5
}
