"""DataCoolie local Polars maintenance runner reference."""

from __future__ import annotations

import argparse
import json
import logging
from pathlib import PurePosixPath
from urllib.parse import urlparse

from datacoolie.core.models import DataCoolieRunConfig
from datacoolie.engines.polars_engine import PolarsEngine
from datacoolie.metadata.file_provider import FileProvider
from datacoolie.orchestration.driver import DataCoolieDriver
from datacoolie.platforms.local_platform import LocalPlatform


def positive_int(value: str) -> int:
    parsed = int(value)
    if parsed <= 0:
        raise argparse.ArgumentTypeError("value must be positive")
    return parsed


def require_persistent_path(value: str) -> str:
    parts = PurePosixPath(urlparse(value).path.replace("\\", "/")).parts
    if ".builds" in {part.lower() for part in parts}:
        raise argparse.ArgumentTypeError("mutable state path must be outside .builds/")
    return value


def build_maintenance_preview(
    targets: list,
    *,
    do_compact: bool,
    do_cleanup: bool,
    retention_hours: int,
) -> list[dict]:
    operations = [
        operation
        for operation, enabled in (("compact", do_compact), ("cleanup", do_cleanup))
        if enabled
    ]
    preview = []
    for target in targets:
        destination = target.destination
        preview.append(
            {
                "dataflow": target.name or target.dataflow_id,
                "connection": destination.connection.name,
                "format": destination.connection.format,
                "destination_key": destination.destination_key,
                "table": destination.full_table_name,
                "path": destination.path,
                "operations": operations,
                "retention_hours": retention_hours,
            }
        )
    return sorted(preview, key=lambda item: item["destination_key"])


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--metadata-path", required=True)
    parser.add_argument("--watermark-base-path", required=True, type=require_persistent_path)
    parser.add_argument("--base-log-path", required=True, type=require_persistent_path)
    parser.add_argument("--connection", action="append")
    parser.add_argument("--no-compact", action="store_true")
    parser.add_argument("--no-cleanup", action="store_true")
    parser.add_argument("--retention-hours", type=positive_int, default=168)
    parser.add_argument("--max-workers", type=positive_int, default=4)
    parser.add_argument("--inspect-only", action="store_true")
    parser.add_argument("--confirm-maintenance", action="store_true")
    args = parser.parse_args()
    if args.no_compact and args.no_cleanup:
        parser.error("maintenance must enable compact, cleanup, or both")
    if not args.inspect_only and not args.confirm_maintenance:
        parser.error("maintenance mutation requires --confirm-maintenance")
    return args


def main() -> int:
    args = parse_args()
    platform = LocalPlatform()
    engine = PolarsEngine(platform=platform)
    metadata = FileProvider(
        config_path=args.metadata_path,
        platform=platform,
        watermark_base_path=args.watermark_base_path,
    )
    config = DataCoolieRunConfig(
        retention_hours=args.retention_hours,
        max_workers=args.max_workers,
        stop_on_error=True,
    )

    with DataCoolieDriver(
        engine=engine,
        metadata_provider=metadata,
        base_log_path=args.base_log_path,
        config=config,
    ) as driver:
        if args.inspect_only:
            targets = driver.load_maintenance_dataflows(connection=args.connection)
            preview = build_maintenance_preview(
                targets,
                do_compact=not args.no_compact,
                do_cleanup=not args.no_cleanup,
                retention_hours=args.retention_hours,
            )
            print(json.dumps(preview, indent=2, sort_keys=True))
            return 0
        print(
            json.dumps(
                {
                    "connections": args.connection or [],
                    "operations": [
                        operation
                        for operation, enabled in (
                            ("compact", not args.no_compact),
                            ("cleanup", not args.no_cleanup),
                        )
                        if enabled
                    ],
                    "retention_hours": args.retention_hours,
                },
                sort_keys=True,
            )
        )
        result = driver.run_maintenance(
            connection=args.connection,
            do_compact=not args.no_compact,
            do_cleanup=not args.no_cleanup,
        )
        return 1 if result.failed else 0


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    raise SystemExit(main())
