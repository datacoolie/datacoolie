{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacoolie.github.io/datacoolie/schema/current-build.schema.json",
  "title": "DataCoolie Runnable Current Build Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "build_id"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "current_build"},
    "build_id": {
      "type": "string",
      "pattern": "^[0-9]{6}-[0-9]{6}-[0-9a-f]{12}$"
    }
  }
}
