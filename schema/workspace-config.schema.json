{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacoolie.github.io/datacoolie/schema/workspace-config.schema.json",
  "title": "DataCoolie workspace config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "environments"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "workspace_name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "workspace_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        }
      }
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform"],
        "properties": {
          "platform": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
