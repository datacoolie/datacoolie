{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacoolie.github.io/datacoolie/schema/build-verification-receipt.schema.json",
  "title": "DataCoolie Build Verification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "receipt_id",
    "status",
    "build_id",
    "environment",
    "platform",
    "datacoolie_version",
    "runner",
    "metadata",
    "functions_artifact",
    "operation",
    "stage",
    "execution_reference",
    "base_log_path",
    "watermark_base_path",
    "checks",
    "started_at",
    "finished_at",
    "unresolved_issues"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "artifact_type": {"const": "build_verification"},
    "receipt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "status": {"enum": ["succeeded", "failed"]},
    "build_id": {
      "type": "string",
      "pattern": "^[0-9]{6}-[0-9]{6}-[0-9a-f]{12}$"
    },
    "environment": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "datacoolie_version": {"type": "string", "minLength": 1},
    "runner": {"$ref": "#/$defs/artifact"},
    "metadata": {"$ref": "#/$defs/metadata_set"},
    "functions_artifact": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/function_artifact"}]
    },
    "operation": {"enum": ["run", "replay", "maintenance"]},
    "stage": {"type": ["string", "null"], "minLength": 1},
    "execution_reference": {"type": "string", "minLength": 1},
    "base_log_path": {"type": "string", "minLength": 1},
    "watermark_base_path": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "unresolved_issues": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "metadata_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "files", "sha256"],
      "properties": {
        "layout": {"enum": ["single", "split-connections", "split-all"]},
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["config_path"],
          "properties": {
            "config_path": {"$ref": "#/$defs/artifact"},
            "connections_path": {"$ref": "#/$defs/artifact"},
            "schema_hints_path": {"$ref": "#/$defs/artifact"}
          }
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"layout": {"const": "single"}}},
          "then": {
            "properties": {
              "files": {
                "not": {
                  "anyOf": [
                    {"required": ["connections_path"]},
                    {"required": ["schema_hints_path"]}
                  ]
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"layout": {"const": "split-connections"}}},
          "then": {
            "properties": {
              "files": {
                "required": ["config_path", "connections_path"],
                "not": {"required": ["schema_hints_path"]}
              }
            }
          }
        },
        {
          "if": {"properties": {"layout": {"const": "split-all"}}},
          "then": {
            "properties": {
              "files": {
                "required": ["config_path", "connections_path", "schema_hints_path"]
              }
            }
          }
        }
      ]
    },
    "function_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "sha256",
        "import_prefix",
        "distribution",
        "version"
      ],
      "properties": {
        "format": {"enum": ["wheel", "zip"]},
        "path": {"type": "string", "pattern": "^functions/[^/]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "import_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "distribution": {"type": ["string", "null"], "minLength": 1},
        "version": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"format": {"const": "wheel"}}},
          "then": {
            "properties": {
              "distribution": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "else": {
            "properties": {
              "distribution": {"type": "null"},
              "version": {"type": "null"}
            }
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "skipped"]},
        "evidence": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "skipped"}}},
          "then": {"properties": {"evidence": {"type": "string", "minLength": 1}}}
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {
        "properties": {
          "checks": {
            "allOf": [
              {
                "items": {
                  "properties": {"status": {"enum": ["passed", "skipped"]}}
                }
              },
              {
                "contains": {
                  "properties": {
                    "name": {"const": "generated-artifact-validation"},
                    "status": {"const": "passed"}
                  },
                  "required": ["name", "status"]
                }
              }
            ]
          },
          "unresolved_issues": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "type": "object",
              "properties": {"status": {"const": "failed"}},
              "required": ["status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "succeeded"},
          "functions_artifact": {"type": "object"}
        },
        "required": ["status", "functions_artifact"]
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "name": {"const": "functions-artifact-import"},
                "status": {"const": "passed"}
              },
              "required": ["name", "status"]
            }
          }
        }
      }
    }
  ]
}
