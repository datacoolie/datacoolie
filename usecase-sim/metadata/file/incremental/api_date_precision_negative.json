{
  "connections": [
    {
      "name": "case_api_source",
      "connection_type": "api",
      "format": "api",
      "configure": {
        "base_url": "http://localhost:8082",
        "timeout": 10
      }
    },
    {
      "name": "case_parquet_dest",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "__CASE_ROOT__/output"
      }
    }
  ],
  "dataflows": [
    {
      "name": "api_wm__date_precision_negative",
      "stage": "api_wm__date_precision_negative",
      "processing_mode": "batch",
      "source": {
        "connection_name": "case_api_source",
        "table": "orders",
        "watermark_columns": [
          "event_date"
        ],
        "configure": {
          "endpoint": "/api/orders/date-only",
          "pagination_type": "offset",
          "page_size": 5,
          "data_path": "data",
          "range_param_mapping": {
            "event_date": {
              "lower": {
                "location": "params",
                "name": "modified_since",
                "operator": ">"
              },
              "format": "date",
              "response_column": "event_date",
              "watermark_value": "observed_max"
            }
          }
        }
      },
      "destination": {
        "connection_name": "case_parquet_dest",
        "table": "orders",
        "load_type": "append"
      },
      "transform": {
        "schema_hints": [
          {
            "column_name": "event_date",
            "data_type": "DATE",
            "format": "yyyy-MM-dd"
          }
        ]
      }
    }
  ]
}
