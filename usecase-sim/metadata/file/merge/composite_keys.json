{
  "connections": [
    {
      "name": "merge_composite_keys_source",
      "connection_type": "file",
      "format": "parquet",
      "configure": {"base_path": "__CASE_ROOT__/input"}
    },
    {
      "name": "merge_composite_keys_destination",
      "connection_type": "lakehouse",
      "format": "delta",
      "configure": {"base_path": "__CASE_ROOT__/output"}
    }
  ],
  "dataflows": [
    {
      "name": "merge-composite-keys",
      "stage": "merge_composite_keys",
      "source": {
        "connection_name": "merge_composite_keys_source",
        "table": "rows"
      },
      "destination": {
        "connection_name": "merge_composite_keys_destination",
        "table": "orders",
        "load_type": "merge_upsert",
        "merge_keys": ["id", "tenant"]
      }
    }
  ]
}
