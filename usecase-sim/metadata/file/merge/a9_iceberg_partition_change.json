{
  "connections": [
    {
      "name": "a9_iceberg_partition_source",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "__CASE_ROOT__/input"
      }
    },
    {
      "name": "a9_iceberg_partition_destination",
      "connection_type": "lakehouse",
      "format": "iceberg",
      "catalog": "local_catalog",
      "database": "__ICEBERG_NAMESPACE__",
      "configure": {
        "base_path": "__CASE_ROOT__/output"
      }
    }
  ],
  "dataflows": [
    {
      "name": "a9-iceberg-partition-change",
      "stage": "a9_iceberg_partition_change",
      "processing_mode": "batch",
      "source": {
        "connection_name": "a9_iceberg_partition_source",
        "table": "records"
      },
      "destination": {
        "connection_name": "a9_iceberg_partition_destination",
        "table": "events",
        "load_type": "merge_upsert",
        "merge_keys": ["id"],
        "partition_columns": [
          {
            "column": "region"
          }
        ]
      }
    }
  ]
}
