{
  "connections": [
    {
      "name": "merge_custom_predicate_source",
      "connection_type": "file",
      "format": "parquet",
      "configure": {"base_path": "__CASE_ROOT__/input"}
    },
    {
      "name": "merge_custom_predicate_destination",
      "connection_type": "lakehouse",
      "format": "delta",
      "configure": {"base_path": "__CASE_ROOT__/output"}
    }
  ],
  "dataflows": [
    {
      "name": "merge-custom-predicate",
      "stage": "merge_custom_predicate",
      "source": {
        "connection_name": "merge_custom_predicate_source",
        "table": "rows"
      },
      "destination": {
        "connection_name": "merge_custom_predicate_destination",
        "table": "orders",
        "load_type": "merge_upsert",
        "merge_keys": ["id"],
        "configure": {
          "merge_options": {
            "source_alias": "s",
            "target_alias": "t",
            "predicate": "t.id = s.id AND t.scope = s.scope"
          }
        }
      }
    }
  ]
}
