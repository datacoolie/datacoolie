{
  "connections": [
    {
      "name": "aws_csv_source",
      "connection_type": "file",
      "format": "csv",
      "configure": {
        "base_path": "s3://datacoolie-test/input/csv",
        "read_options": {
          "header": "true",
          "inferSchema": "true"
        }
      }
    },
    {
      "name": "aws_json_source",
      "connection_type": "file",
      "format": "json",
      "configure": {
        "base_path": "s3://datacoolie-test/input/json",
        "read_options": {
          "multiLine": "true"
        }
      }
    },
    {
      "name": "aws_parquet_source",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "s3://datacoolie-test/input/parquet"
      }
    },
    {
      "name": "aws_avro_source",
      "connection_type": "file",
      "format": "avro",
      "configure": {
        "base_path": "s3://datacoolie-test/input/avro"
      }
    },
    {
      "name": "aws_jsonl_source",
      "connection_type": "file",
      "format": "jsonl",
      "configure": {
        "base_path": "s3://datacoolie-test/input/jsonl"
      }
    },
    {
      "name": "aws_csv_dest",
      "connection_type": "file",
      "format": "csv",
      "configure": {
        "base_path": "s3://datacoolie-test/output/csv"
      }
    },
    {
      "name": "aws_json_dest",
      "connection_type": "file",
      "format": "json",
      "configure": {
        "base_path": "s3://datacoolie-test/output/json"
      }
    },
    {
      "name": "aws_parquet_dest",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "s3://datacoolie-test/output/parquet",
        "write_options": {
          "compression": "snappy"
        }
      }
    },
    {
      "name": "aws_avro_dest",
      "connection_type": "file",
      "format": "avro",
      "configure": {
        "base_path": "s3://datacoolie-test/output/avro"
      }
    },
    {
      "name": "aws_jsonl_dest",
      "connection_type": "file",
      "format": "jsonl",
      "configure": {
        "base_path": "s3://datacoolie-test/output/jsonl"
      }
    },
    {
      "name": "aws_delta_source",
      "connection_type": "lakehouse",
      "format": "delta",
      "configure": {
        "base_path": "s3://datacoolie-test/output/delta"
      }
    },
    {
      "name": "aws_delta_dest",
      "connection_type": "lakehouse",
      "format": "delta",
      "configure": {
        "base_path": "s3://datacoolie-test/output/delta"
      }
    },
    {
      "name": "aws_iceberg_source",
      "connection_type": "lakehouse",
      "format": "iceberg",
      "catalog": "local_catalog",
      "database": "default",
      "configure": {
        "base_path": "s3://datacoolie-test/output/iceberg"
      }
    },
    {
      "name": "aws_iceberg_dest",
      "connection_type": "lakehouse",
      "format": "iceberg",
      "catalog": "local_catalog",
      "database": "default",
      "configure": {
        "base_path": "s3://datacoolie-test/output/iceberg"
      }
    },
    {
      "name": "aws_sqlite_source",
      "connection_type": "database",
      "format": "sql",
      "database": "DATACOOLIE_SQLITE_DB",
      "configure": {
        "database_type": "sqlite",
        "database": "DATACOOLIE_SQLITE_DB"
      },
      "secrets_ref": {
        "env:": [
          "database"
        ]
      }
    },
    {
      "name": "aws_postgres_source",
      "connection_type": "database",
      "format": "sql",
      "database": "DATACOOLIE_PG_DB",
      "configure": {
        "database_type": "postgresql",
        "host": "localhost",
        "port": 5432,
        "database": "datacoolie",
        "username": "DATACOOLIE_PG_USER",
        "password": "DATACOOLIE_PG_PASS"
      },
      "secrets_ref": {
        "env:": [
          "username",
          "password"
        ]
      }
    },
    {
      "name": "aws_parquet_date_folder_src",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "s3://datacoolie-test/input/parquet_dated",
        "date_folder_partitions": "{year}/{month}/{day}"
      }
    },
    {
      "name": "aws_parquet_date_folder_dest",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "s3://datacoolie-test/output/parquet_dated",
        "date_folder_partitions": "{year}/{month}/{day}"
      }
    },
    {
      "name": "aws_parquet_hive_src",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "s3://datacoolie-test/input/parquet_hive",
        "use_hive_partitioning": true
      }
    },
    {
      "name": "aws_function_src",
      "connection_type": "function",
      "format": "function",
      "configure": {}
    },
    {
      "name": "aws_csv_no_hint",
      "connection_type": "file",
      "format": "csv",
      "configure": {
        "base_path": "s3://datacoolie-test/input/csv",
        "read_options": {
          "header": "true",
          "inferSchema": "true"
        },
        "use_schema_hint": false
      }
    }
  ],
  "schema_hints": [
    {
      "connection_name": "aws_json_source",
      "table_name": "sample",
      "hints": [
        {
          "column_name": "order_date",
          "data_type": "DATE",
          "format": "yyyy-MM-dd"
        },
        {
          "column_name": "amount",
          "data_type": "DECIMAL",
          "precision": 18,
          "scale": 2
        },
        {
          "column_name": "quantity",
          "data_type": "INTEGER"
        }
      ]
    },
    {
      "connection_name": "aws_delta_dest",
      "table_name": "orders_merged",
      "hints": [
        {
          "column_name": "order_date",
          "data_type": "DATE",
          "format": "yyyy-MM-dd"
        },
        {
          "column_name": "amount",
          "data_type": "DECIMAL",
          "precision": 18,
          "scale": 2
        },
        {
          "column_name": "quantity",
          "data_type": "INTEGER"
        }
      ]
    },
    {
      "connection_name": "aws_parquet_dest",
      "table_name": "orders",
      "hints": [
        {
          "column_name": "order_date",
          "data_type": "DATE",
          "format": "yyyy-MM-dd"
        },
        {
          "column_name": "amount",
          "data_type": "DECIMAL",
          "precision": 18,
          "scale": 2
        }
      ]
    }
  ]
}
