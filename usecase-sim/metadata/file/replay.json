{
  "dataflows": [
    {
      "name": "replay__orders",
      "stage": "replay_test",
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_parquet_source",
        "table": "sample",
        "watermark_columns": [
          "modified_at"
        ]
      },
      "transform": {
        "schema_hints": [
          {
            "column_name": "order_date",
            "data_type": "DATE",
            "format": "yyyy-MM-dd"
          },
          {
            "column_name": "modified_at",
            "data_type": "TIMESTAMP"
          },
          {
            "column_name": "order_id",
            "data_type": "INTEGER"
          }
        ]
      },
      "destination": {
        "connection_name": "local_delta_dest",
        "table": "orders_replay",
        "load_type": "append"
      }
    },
    {
      "name": "api_replay_validation",
      "stage": "replay_api_validation",
      "processing_mode": "batch",
      "source": {
        "connection_name": "replay_api_source",
        "table": "orders",
        "watermark_columns": [
          "order_date"
        ],
        "configure": {
          "endpoint": "/api/orders/ranged",
          "data_path": "data",
          "range_param_mapping": {
            "modified_at": {
              "lower": {
                "location": "params",
                "name": "modified_since",
                "operator": ">="
              },
              "upper": {
                "location": "params",
                "name": "modified_until",
                "operator": "<"
              },
              "format": "iso",
              "response_column": "modified_at",
              "watermark_value": "observed_max"
            }
          }
        }
      },
      "destination": {
        "connection_name": "replay_delta_dest",
        "table": "api_replay_validation",
        "load_type": "append"
      }
    },
    {
      "name": "aws_replay_validation",
      "stage": "aws_replay_validation",
      "processing_mode": "batch",
      "source": {
        "connection_name": "replay_aws_parquet_source",
        "table": "sample",
        "watermark_columns": [
          "order_date"
        ]
      },
      "transform": {
        "schema_hints": [
          {
            "column_name": "order_date",
            "data_type": "DATE",
            "format": "yyyy-MM-dd"
          },
          {
            "column_name": "modified_at",
            "data_type": "TIMESTAMP"
          },
          {
            "column_name": "order_id",
            "data_type": "INTEGER"
          }
        ]
      },
      "destination": {
        "connection_name": "replay_aws_delta_dest",
        "table": "aws_replay_validation",
        "load_type": "append"
      }
    },
    {
      "name": "iceberg_replay_validation",
      "stage": "iceberg_replay_validation",
      "processing_mode": "batch",
      "source": {
        "connection_name": "replay_iceberg_source",
        "table": "replay_iceberg_source",
        "watermark_columns": [
          "order_date"
        ],
        "configure": {
          "backward_days": 7
        }
      },
      "destination": {
        "connection_name": "replay_iceberg_dest",
        "table": "iceberg_replay_validation",
        "load_type": "merge_overwrite",
        "merge_keys": [
          "order_id"
        ],
        "configure": {
          "replace_by_watermark": true
        }
      },
      "transform": {}
    },
    {
      "name": "sql_replay_validation",
      "stage": "replay_sql_validation",
      "processing_mode": "batch",
      "source": {
        "connection_name": "sqlite_replay_source",
        "table": "orders",
        "watermark_columns": [
          "order_date"
        ]
      },
      "destination": {
        "connection_name": "replay_delta_dest",
        "table": "sql_replay_validation",
        "load_type": "append"
      }
    }
  ]
}
