{
  "shared_metadata": "metadata/file/shared/local.json",
  "dataflows": [
    {
      "name": "combined__dedup_schema_addcols_partition",
      "stage": "transform_combined",
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_csv_source",
        "table": "sample"
      },
      "transform": {
        "deduplicate_columns": [
          "order_id"
        ],
        "latest_data_columns": [
          "modified_at"
        ],
        "additional_columns": [
          {
            "column": "etl_batch",
            "expression": "'combined_test'"
          }
        ],
        "schema_hints": [
          {
            "column_name": "order_date",
            "data_type": "DATE",
            "format": "yyyy-MM-dd"
          },
          {
            "column_name": "amount",
            "data_type": "DECIMAL",
            "precision": 18,
            "scale": 2
          }
        ]
      },
      "destination": {
        "connection_name": "local_delta_dest",
        "table": "orders_combined",
        "load_type": "overwrite",
        "partition_columns": [
          {
            "column": "order_year",
            "expression": "EXTRACT(YEAR FROM order_date)"
          }
        ]
      }
    }
  ]
}
