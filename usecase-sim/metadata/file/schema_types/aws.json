    {
      "name": "aws_load_delta__schema_evolve_base",
      "description": "Schema evolution test: initial write with base columns only",
      "stage": "aws_schema_evolve_delta",
      "group_number": 2,
      "execution_order": 10,
      "processing_mode": "batch",
      "source": {
        "connection_name": "aws_parquet_source",
        "table": "sample"
      },
      "destination": {
        "connection_name": "aws_delta_dest",
        "table": "orders_schema_evolve",
        "load_type": "overwrite"
      },
      "transform": {
        "schema_hints": [
          {
            "column_name": "order_date",
            "data_type": "DATE",
            "format": "yyyy-MM-dd"
          }
        ]
      }
    },
    {
      "name": "aws_load_delta__schema_evolve_new_cols",
      "description": "Schema evolution test: append with additional columns triggers merge schema",
      "stage": "aws_schema_evolve_delta",
      "group_number": 2,
      "execution_order": 11,
      "processing_mode": "batch",
      "source": {
        "connection_name": "aws_parquet_source",
        "table": "sample"
      },
      "destination": {
        "connection_name": "aws_delta_dest",
        "table": "orders_schema_evolve",
        "load_type": "append"
      },
      "transform": {
        "additional_columns": [
          {
            "column": "order_year",
            "expression": "EXTRACT(YEAR FROM order_date)"
          },
          {
            "column": "amount_category",
            "expression": "CASE WHEN CAST(amount AS DOUBLE) > 100 THEN 'high' ELSE 'low' END"
          }
        ],
        "schema_hints": [
          {
            "column_name": "order_date",
            "data_type": "DATE",
            "format": "yyyy-MM-dd"
          }
        ]
      }
    },
