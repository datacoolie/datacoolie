      "processing_mode": "batch",
      "source": {
        "connection_name": "aws_csv_source",
        "table": "sample"
      },
      "destination": {
        "connection_name": "aws_parquet_dest",
        "table": "orders_schema_date",
        "load_type": "overwrite"
      },
      "transform": {
        "schema_hints": [
          {
            "column_name": "order_date",
            "data_type": "DATE",
            "format": "yyyy-MM-dd"
