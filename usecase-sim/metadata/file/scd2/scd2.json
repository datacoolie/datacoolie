{
  "connections": [
    {
      "name": "scd2_source",
      "connection_type": "file",
      "format": "parquet",
      "configure": {"base_path": "__CASE_ROOT__/input"}
    },
    {
      "name": "scd2_destination",
      "connection_type": "lakehouse",
      "format": "delta",
      "configure": {"base_path": "__CASE_ROOT__/output"}
    }
  ],
  "dataflows": [
    {
      "name": "scd2-seed",
      "stage": "scd2_seed",
      "source": {
        "connection_name": "scd2_source",
        "table": "initial"
      },
      "destination": {
        "connection_name": "scd2_destination",
        "table": "customers",
        "load_type": "scd2",
        "merge_keys": ["id"],
        "configure": {"scd2_effective_column": "modified_at"}
      }
    },
    {
      "name": "scd2-change",
      "stage": "scd2_change",
      "source": {
        "connection_name": "scd2_source",
        "table": "changed",
        "watermark_columns": ["__file_modification_time"]
      },
      "destination": {
        "connection_name": "scd2_destination",
        "table": "customers",
        "load_type": "scd2",
        "merge_keys": ["id"],
        "configure": {"scd2_effective_column": "modified_at"}
      }
    }
  ]
}
