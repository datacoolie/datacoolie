{
  "connections": [
    {
      "name": "write_basic_source",
      "connection_type": "file",
      "format": "parquet",
      "configure": {"base_path": "__CASE_ROOT__/input"}
    },
    {
      "name": "write_basic_destination",
      "connection_type": "lakehouse",
      "format": "delta",
      "configure": {"base_path": "__CASE_ROOT__/output"}
    }
  ],
  "dataflows": [
    {
      "name": "write-basic-overwrite",
      "stage": "write_basic_overwrite",
      "source": {
        "connection_name": "write_basic_source",
        "table": "overwrite_source"
      },
      "destination": {
        "connection_name": "write_basic_destination",
        "table": "overwrite_target",
        "load_type": "overwrite"
      }
    },
    {
      "name": "write-basic-append",
      "stage": "write_basic_append",
      "source": {
        "connection_name": "write_basic_source",
        "table": "append_source",
        "watermark_columns": ["__file_modification_time"]
      },
      "destination": {
        "connection_name": "write_basic_destination",
        "table": "append_target",
        "load_type": "append"
      }
    }
  ]
}
