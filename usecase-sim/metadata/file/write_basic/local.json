        "load_type": "overwrite"
      }
    },
    {
      "name": "load_delta__append",
      "stage": "load_delta",
      "group_number": 2,
      "execution_order": 1,
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_parquet_source",
        "table": "sample",
        "watermark_columns": [
          "__file_modification_time"
        ]
      },
      "destination": {
        "connection_name": "local_delta_dest",
        "table": "orders_appended",
        "load_type": "append"
      }
    },
    {
      "name": "load_iceberg__full_load",
      "stage": "load_iceberg",
      "group_number": 3,
      "execution_order": 1,
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_json_source",
        "table": "sample"
      },
      "transform": {
        "schema_hints": [
          {
            "column_name": "order_date",
            "data_type": "DATE",
            "format": "yyyy-MM-dd"
          },
          {
            "column_name": "amount",
            "data_type": "DECIMAL",
            "precision": 18,
            "scale": 2
          },
          {
            "column_name": "quantity",
            "data_type": "INTEGER"
          }
        ]
      },
      "destination": {
        "connection_name": "local_iceberg_dest",
        "table": "orders_from_json",
        "load_type": "full_load"
      }
    },
    {
      "name": "load_iceberg__overwrite",
      "stage": "load_iceberg",
      "group_number": 3,
      "execution_order": 2,
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_parquet_source",
        "table": "sample"
      },
      "transform": {
        "schema_hints": [
          {
            "column_name": "order_date",
            "data_type": "DATE",
            "format": "yyyy-MM-dd"
          }
        ]
      },
      "destination": {
        "connection_name": "local_iceberg_dest",
        "table": "orders_overwritten",
        "load_type": "overwrite",
        "partition_columns": [
          {
            "column": "order_year",
            "expression": "EXTRACT(YEAR FROM order_date)"
          },
          {
            "column": "order_month",
            "expression": "EXTRACT(MONTH FROM order_date)"
          }
        ]
      }
    },
    {
      "name": "load_iceberg__append",
      "stage": "load_iceberg",
