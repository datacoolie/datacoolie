        "load_type": "full_load"
      }
    },
    {
      "name": "load_delta__full_load",
      "stage": "load_delta",
      "group_number": 2,
      "execution_order": -1,
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_parquet_source",
        "table": "sample"
      },
      "destination": {
        "connection_name": "local_delta_dest",
        "table": "orders_full_load",
