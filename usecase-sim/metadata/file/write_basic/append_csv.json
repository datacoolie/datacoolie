{
  "connections": [
    {
      "name": "flat_append_source",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "__CASE_ROOT__/input"
      }
    },
    {
      "name": "flat_append_csv_destination",
      "connection_type": "file",
      "format": "csv",
      "configure": {
        "base_path": "__CASE_ROOT__/output"
      }
    }
  ],
  "dataflows": [
    {
      "name": "flat-append-csv",
      "stage": "flat_append_csv",
      "processing_mode": "batch",
      "source": {
        "connection_name": "flat_append_source",
        "table": "source"
      },
      "destination": {
        "connection_name": "flat_append_csv_destination",
        "table": "target",
        "load_type": "append"
      }
    }
  ]
}
