{
  "connections": [
    {
      "name": "a9_api_rate_case",
      "connection_type": "api",
      "format": "api",
      "configure": {
        "base_url": "__MOCK_BASE_URL__",
        "timeout": 30,
        "default_headers": {
          "X-Sim-Case-Token": "__RATE_CASE_TOKEN__"
        }
      }
    },
    {
      "name": "a9_api_parquet_dest",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "__CASE_ROOT__/output/parquet",
        "write_options": {
          "compression": "snappy"
        }
      }
    }
  ],
  "dataflows": [
    {
      "name": "api_service__rate_limit_case",
      "stage": "api_service_rate_limit",
      "processing_mode": "batch",
      "source": {
        "connection_name": "a9_api_rate_case",
        "table": "orders",
        "configure": {
          "endpoint": "/api/orders/rate-limited",
          "data_path": "data",
          "max_retries": 2
        }
      },
      "destination": {
        "connection_name": "a9_api_parquet_dest",
        "table": "orders_api_rate_case",
        "load_type": "overwrite"
      }
    }
  ]
}
