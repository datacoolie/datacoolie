{
  "connections": [
    {
      "name": "a9_api_oauth2_json",
      "connection_type": "api",
      "format": "api",
      "configure": {
        "base_url": "__MOCK_BASE_URL__",
        "auth_type": "oauth2_client_credentials",
        "token_url": "__MOCK_BASE_URL__/oauth/token",
        "client_id": "DATACOOLIE_OAUTH2_CLIENT_ID",
        "client_secret": "DATACOOLIE_OAUTH2_CLIENT_SECRET",
        "token_request_body_format": "json",
        "scope": "read:orders",
        "token_request_extras": {
          "audience": "datacoolie-orders"
        },
        "timeout": 30
      },
      "secrets_ref": {
        "": [
          "client_id",
          "client_secret"
        ]
      }
    },
    {
      "name": "a9_api_parquet_dest",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "__CASE_ROOT__/output/parquet",
        "write_options": {
          "compression": "snappy"
        }
      }
    }
  ],
  "dataflows": [
    {
      "name": "api_service__oauth2_json",
      "stage": "api_service_oauth2_json",
      "processing_mode": "batch",
      "source": {
        "connection_name": "a9_api_oauth2_json",
        "table": "orders",
        "configure": {
          "endpoint": "/api/secure/oauth2",
          "data_path": "data"
        }
      },
      "destination": {
        "connection_name": "a9_api_parquet_dest",
        "table": "orders_api_oauth2_json",
        "load_type": "overwrite"
      }
    }
  ]
}
