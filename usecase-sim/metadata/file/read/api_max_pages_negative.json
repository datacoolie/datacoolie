{
  "connections": [
    {
      "name": "case_api_source",
      "connection_type": "api",
      "format": "api",
      "configure": {
        "base_url": "http://localhost:8082",
        "timeout": 10
      }
    },
    {
      "name": "case_parquet_dest",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "__CASE_ROOT__/output"
      }
    }
  ],
  "dataflows": [
    {
      "name": "api_request__max_pages",
      "stage": "api_request__max_pages",
      "processing_mode": "batch",
      "source": {
        "connection_name": "case_api_source",
        "table": "orders",
        "configure": {
          "endpoint": "/api/orders/offset",
          "pagination_type": "offset",
          "page_size": 5,
          "data_path": "data",
          "max_pages": 2
        }
      },
      "destination": {
        "connection_name": "case_parquet_dest",
        "table": "orders",
        "load_type": "overwrite"
      }
    }
  ]
}
