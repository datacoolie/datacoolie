{
  "connections": [
    {
      "name": "replay_aws_parquet_source",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "s3://datacoolie-test/input/parquet"
      }
    },
    {
      "name": "replay_aws_delta_dest",
      "connection_type": "lakehouse",
      "format": "delta",
      "configure": {
        "base_path": "s3://datacoolie-test/output/delta"
      }
    }
  ],
  "dataflows": [
    {
      "name": "aws_replay_validation",
      "stage": "aws_replay_validation",
      "processing_mode": "batch",
      "source": {
        "connection_name": "replay_aws_parquet_source",
        "table": "sample",
        "watermark_columns": [
          "order_date"
        ]
      },
      "transform": {
        "schema_hints": [
          {
            "column_name": "order_date",
            "data_type": "DATE",
            "format": "yyyy-MM-dd"
          },
          {
            "column_name": "modified_at",
            "data_type": "TIMESTAMP"
          },
          {
            "column_name": "order_id",
            "data_type": "INTEGER"
          }
        ]
      },
      "destination": {
        "connection_name": "replay_aws_delta_dest",
        "table": "aws_replay_validation",
        "load_type": "append"
      }
    }
  ]
}
