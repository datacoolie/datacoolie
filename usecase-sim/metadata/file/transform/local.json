{
  "shared_metadata": "metadata/file/shared/local.json",
  "dataflows": [
    {
      "name": "dedup__row_number",
      "stage": "transform_dedup",
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_csv_source",
        "table": "sample"
      },
      "transform": {
        "deduplicate_columns": [
          "order_id"
        ],
        "latest_data_columns": [
          "modified_at"
        ]
      },
      "destination": {
        "connection_name": "local_parquet_dest",
        "table": "orders_dedup_row_number",
        "load_type": "overwrite"
      }
    },
    {
      "name": "dedup__rank",
      "stage": "transform_dedup",
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_csv_source",
        "table": "sample"
      },
      "transform": {
        "deduplicate_columns": [
          "order_id"
        ],
        "latest_data_columns": [
          "modified_at"
        ],
        "configure": {
          "deduplicate_by_rank": true
        }
      },
      "destination": {
        "connection_name": "local_parquet_dest",
        "table": "orders_dedup_rank",
        "load_type": "overwrite"
      }
    },
    {
      "name": "dedup__no_order_col",
      "stage": "transform_dedup",
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_csv_source",
        "table": "sample"
      },
      "transform": {
        "deduplicate_columns": [
          "order_id"
        ]
      },
      "destination": {
        "connection_name": "local_parquet_dest",
        "table": "orders_dedup_no_order",
        "load_type": "overwrite"
      }
    },
    {
      "name": "addcols__literal",
      "stage": "transform_addcols",
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_csv_source",
        "table": "sample"
      },
      "transform": {
        "additional_columns": [
          {
            "column": "ingested_at",
            "expression": "'batch_ingest'"
          },
          {
            "column": "etl_source",
            "expression": "'usecase_sim'"
          }
        ]
      },
      "destination": {
        "connection_name": "local_parquet_dest",
        "table": "orders_addcols_literal",
        "load_type": "overwrite"
      }
    },
    {
      "name": "addcols__expression",
      "stage": "transform_addcols",
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_csv_source",
        "table": "sample"
      },
      "transform": {
        "additional_columns": [
          {
            "column": "order_year",
            "expression": "EXTRACT(YEAR FROM order_date)"
          },
          {
            "column": "amount_double",
            "expression": "CAST(amount AS DOUBLE) * 2"
          }
        ],
        "schema_hints": [
          {
            "column_name": "order_date",
            "data_type": "DATE"
          }
        ]
      },
      "destination": {
        "connection_name": "local_parquet_dest",
        "table": "orders_addcols_expr",
        "load_type": "overwrite"
      }
    },
    {
      "name": "row_filter__on_computed_col",
      "description": "RowFilter transformer: filter on a column added by ColumnAdder (slot 35 after slot 30)",
      "stage": "row_filter",
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_csv_source",
        "table": "sample"
      },
      "transform": {
        "filter_expression": "amount_double > 100.0",
        "additional_columns": [
          {
            "column": "amount_double",
            "expression": "CAST(amount AS DOUBLE)"
          }
        ]
      },
      "destination": {
        "connection_name": "local_parquet_dest",
        "table": "orders_row_filter_computed",
        "load_type": "overwrite"
      }
    },
    {
      "name": "row_filter__simple",
      "description": "RowFilter transformer: filter on an existing source column via transform.filter_expression",
      "stage": "row_filter",
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_csv_source",
        "table": "sample"
      },
      "transform": {
        "filter_expression": "region = 'North' AND quantity > 1"
      },
      "destination": {
        "connection_name": "local_parquet_dest",
        "table": "orders_row_filter_simple",
        "load_type": "overwrite"
      }
    },
    {
      "name": "dedup__composite_key",
      "stage": "transform_dedup",
      "processing_mode": "batch",
      "source": {
        "connection_name": "local_csv_source",
        "table": "sample"
      },
      "transform": {
        "deduplicate_columns": [
          "order_id",
          "region"
        ],
        "latest_data_columns": [
          "modified_at"
        ]
      },
      "destination": {
        "connection_name": "local_parquet_dest",
        "table": "orders_dedup_composite",
        "load_type": "overwrite"
      }
    }
  ]
}
