{
  "connections": [
    {
      "name": "a9_transform_source",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "__CASE_ROOT__/input"
      }
    },
    {
      "name": "a9_transform_destination",
      "connection_type": "lakehouse",
      "format": "delta",
      "configure": {
        "base_path": "__CASE_ROOT__/output"
      }
    }
  ],
  "dataflows": [
    {
      "name": "a9-transform-uppercase",
      "stage": "a9_transform_uppercase",
      "processing_mode": "batch",
      "source": {
        "connection_name": "a9_transform_source",
        "table": "rows"
      },
      "transform": {
        "value_rules": [
          {
            "operation": "case",
            "columns": ["mixed_text"],
            "mode": "upper"
          }
        ]
      },
      "destination": {
        "connection_name": "a9_transform_destination",
        "table": "uppercase",
        "load_type": "overwrite"
      }
    },
    {
      "name": "a9-transform-map-null",
      "stage": "a9_transform_map_null",
      "processing_mode": "batch",
      "source": {
        "connection_name": "a9_transform_source",
        "table": "rows"
      },
      "transform": {
        "value_rules": [
          {
            "operation": "map",
            "columns": ["status"],
            "mapping": {
              "A": "active",
              "I": "inactive"
            },
            "on_unmapped": "null"
          }
        ]
      },
      "destination": {
        "connection_name": "a9_transform_destination",
        "table": "map_null",
        "load_type": "overwrite"
      }
    },
    {
      "name": "a9-transform-partial-keep-start",
      "stage": "a9_transform_partial_keep_start",
      "processing_mode": "batch",
      "source": {
        "connection_name": "a9_transform_source",
        "table": "rows"
      },
      "transform": {
        "masking_rules": [
          {
            "method": "partial",
            "columns": ["phone"],
            "keep_start": 2,
            "keep_end": 2,
            "mask_char": "#"
          }
        ]
      },
      "destination": {
        "connection_name": "a9_transform_destination",
        "table": "partial_keep_start",
        "load_type": "overwrite"
      }
    },
    {
      "name": "a9-transform-timestamp-truncate-hour",
      "stage": "a9_transform_timestamp_truncate_hour",
      "processing_mode": "batch",
      "source": {
        "connection_name": "a9_transform_source",
        "table": "rows"
      },
      "transform": {
        "schema_hints": [
          {
            "column_name": "event_time",
            "data_type": "TIMESTAMP"
          }
        ],
        "masking_rules": [
          {
            "method": "date_truncate",
            "columns": ["event_time"],
            "unit": "hour"
          }
        ]
      },
      "destination": {
        "connection_name": "a9_transform_destination",
        "table": "timestamp_truncate_hour",
        "load_type": "overwrite"
      }
    }
  ]
}
