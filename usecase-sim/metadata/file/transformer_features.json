{
  "connections": [
    {
      "name": "transform_features_source",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "./usecase-sim/data/input/transform_features"
      }
    },
    {
      "name": "transform_features_destination",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "./usecase-sim/data/output/parquet",
        "write_options": {"compression": "snappy"}
      }
    }
  ],
  "dataflows": [
    {
      "name": "transform_value__trim",
      "stage": "transform_features",
      "processing_mode": "batch",
      "source": {"connection_name": "transform_features_source", "table": "sample"},
      "transform": {
        "value_rules": [{"operation": "trim", "columns": ["whitespace_text"]}]
      },
      "destination": {
        "connection_name": "transform_features_destination",
        "table": "tf_value_trim",
        "load_type": "overwrite"
      }
    },
    {
      "name": "transform_value__case",
      "stage": "transform_features",
      "processing_mode": "batch",
      "source": {"connection_name": "transform_features_source", "table": "sample"},
      "transform": {
        "value_rules": [{"operation": "case", "columns": ["email"], "mode": "lower"}]
      },
      "destination": {
        "connection_name": "transform_features_destination",
        "table": "tf_value_case",
        "load_type": "overwrite"
      }
    },
    {
      "name": "transform_value__regex_replace",
      "stage": "transform_features",
      "processing_mode": "batch",
      "source": {"connection_name": "transform_features_source", "table": "sample"},
      "transform": {
        "value_rules": [{
          "operation": "regex_replace",
          "columns": ["formatted_phone"],
          "pattern": "[^0-9]",
          "replacement": ""
        }]
      },
      "destination": {
        "connection_name": "transform_features_destination",
        "table": "tf_value_regex_replace",
        "load_type": "overwrite"
      }
    },
    {
      "name": "transform_value__regex_literal_replacement",
      "stage": "transform_features",
      "processing_mode": "batch",
      "source": {"connection_name": "transform_features_source", "table": "sample"},
      "transform": {
        "value_rules": [{
          "operation": "regex_replace",
          "columns": ["formatted_phone"],
          "pattern": "-",
          "replacement": "$1\\tail"
        }]
      },
      "destination": {
        "connection_name": "transform_features_destination",
        "table": "tf_value_regex_literal",
        "load_type": "overwrite"
      }
    },
    {
      "name": "transform_value__empty_to_null",
      "stage": "transform_features",
      "processing_mode": "batch",
