      },
      "destination": {
        "connection_name": "transform_features_destination",
        "table": "tf_value_empty_to_null",
        "load_type": "overwrite"
      }
    },
    {
      "name": "transform_value__fill_null",
      "stage": "transform_features",
      "processing_mode": "batch",
      "source": {"connection_name": "transform_features_source", "table": "sample"},
      "transform": {
        "value_rules": [{
