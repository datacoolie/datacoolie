      "source": {"connection_name": "transform_features_source", "table": "sample"},
      "transform": {
        "value_rules": [
          {"operation": "empty_to_null", "columns": ["notes"], "order": 20},
          {"operation": "fill_null", "columns": ["notes"], "value": "ordered", "order": 20}
        ]
      },
      "destination": {
        "connection_name": "transform_features_destination",
        "table": "tf_value_stable_order",
        "load_type": "overwrite"
      }
    },
