        }]
      },
      "destination": {
        "connection_name": "transform_features_destination",
        "table": "tf_value_fill_null",
        "load_type": "overwrite"
      }
    },
    {
      "name": "transform_value__map",
      "stage": "transform_features",
      "processing_mode": "batch",
      "source": {"connection_name": "transform_features_source", "table": "sample"},
      "transform": {
        "value_rules": [{
          "operation": "map",
          "columns": ["status"],
          "mapping": {"A": "active", "I": "inactive"},
          "on_unmapped": "keep"
        }]
      },
      "destination": {
        "connection_name": "transform_features_destination",
        "table": "tf_value_map",
        "load_type": "overwrite"
      }
    },
    {
      "name": "transform_value__stable_rule_order",
      "stage": "transform_features",
