  "incremental/api_incremental_recovery": {
    "metadata_path": "metadata/file/incremental.json",
    "dataflows": [
      "api_incremental_recovery_validation"
    ],
    "metadata_bindings": {
      "dataflows": {
        "api_incremental_recovery_validation": {
          "replace": {
            "name": "api_incremental_recovery_validation",
            "stage": "api_incremental_recovery_validation",
            "processing_mode": "batch",
            "source": {
              "connection_name": "api_recovery_source",
              "table": "orders",
              "watermark_columns": [
                "modified_at"
              ],
              "configure": {
                "endpoint": "/api/orders/next-link",
                "pagination_type": "next_link",
                "data_path": "records",
                "next_link_path": "_links.next",
                "page_size": 5,
                "max_pages": 10,
                "params": {
                  "limit": 5
                },
                "range_param_mapping": {
                  "modified_at": {
                    "lower": {
                      "location": "params",
                      "name": "modified_since",
                      "operator": ">="
                    },
                    "format": "iso",
                    "response_column": "modified_at",
                    "watermark_value": "observed_max"
                  }
                }
              }
            },
            "destination": {
              "connection_name": "api_recovery_dest",
              "table": "api_incremental_recovery_validation",
              "load_type": "append"
            }
          }
        }
      }
    },
    "connections": [
      "api_recovery_source",
      "api_recovery_dest"
    ]
  },
