# Generated data, runner outputs, and mutable provider state
.runtime/

# Generated metadata siblings (rebuild with scripts/setup_metadata.py --targets file)
metadata/file/*.yaml
metadata/file/*.xlsx

# Ivy cache for Spark JAR dependencies (usecase-sim/runner/spark-jars/)
**/spark-jars/

# Python
__pycache__/
*.pyc
*.pyo
.env

# Spark artifacts are gitignored at the datacoolie/ level (see datacoolie/.gitignore)

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
