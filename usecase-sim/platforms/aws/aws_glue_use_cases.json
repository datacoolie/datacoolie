{
  "connections": [
    {
      "name": "aws_csv_source",
      "connection_type": "file",
      "format": "csv",
      "configure": {
        "base_path": "s3://de-dev-0007/input/csv",
        "read_options": {
          "header": "true",
          "inferSchema": "true"
        }
      }
    },
    {
      "name": "aws_parquet_dest",
      "connection_type": "file",
      "format": "parquet",
      "configure": {
        "base_path": "s3://de-dev-0007/output/parquet",
        "write_options": {
          "compression": "snappy"
        }
      }
    },
    {
      "name": "aws_delta_source",
      "connection_type": "lakehouse",
      "format": "delta",
      "configure": {
        "base_path": "s3://de-dev-0007/output/delta"
      }
    },
    {
      "name": "aws_delta_dest",
      "connection_type": "lakehouse",
      "format": "delta",
      "database": "datacoolie",
      "configure": {
        "base_path": "s3://de-dev-0007/output/delta",
        "athena_output_location": "s3://de-dev-0007/athena-results/",
        "register_symlink_table": true
      }
    },
    {
      "name": "aws_iceberg_source",
      "connection_type": "lakehouse",
      "format": "iceberg",
      "catalog": "glue_catalog",
      "database": "datacoolie",
      "configure": {
        "base_path": "s3://de-dev-0007/output/iceberg"
      }
    },
    {
      "name": "aws_iceberg_dest",
